<resources>

    <!-- Tema claro dourado, igual ao front web (que também é só claro) -->
    <style name="Theme.TarefaApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ouro_600</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorPrimaryContainer">@color/ouro_100</item>
        <item name="colorOnPrimaryContainer">@color/ouro_800</item>
        <item name="colorSecondary">@color/ouro_500</item>
        <item name="colorOnSecondary">@color/branco</item>
        <item name="colorSecondaryContainer">@color/ouro_100</item>
        <item name="colorOnSecondaryContainer">@color/ouro_800</item>
        <item name="colorTertiary">@color/ouro_700</item>
        <item name="android:colorBackground">@color/fundo_app</item>
        <item name="colorOnBackground">@color/texto_forte</item>
        <item name="colorSurface">@color/branco</item>
        <item name="colorOnSurface">@color/texto_forte</item>
        <item name="colorOnSurfaceVariant">@color/texto_suave</item>
        <item name="colorSurfaceContainerLowest">@color/branco</item>
        <item name="colorSurfaceContainerLow">@color/branco</item>
        <item name="colorSurfaceContainer">@color/branco</item>
        <item name="colorSurfaceContainerHigh">@color/ouro_50</item>
        <item name="colorSurfaceContainerHighest">@color/ouro_100</item>
        <item name="colorOutline">@color/contorno</item>
        <item name="colorOutlineVariant">@color/borda_suave</item>
        <item name="colorError">@color/erro</item>
        <item name="android:windowBackground">@color/fundo_app</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TarefaApp.Dialogo</item>
    </style>

    <style name="ThemeOverlay.TarefaApp.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Forma.Grande</item>
        <item name="colorSurfaceContainerHigh">@color/branco</item>
    </style>

    <style name="Forma.Grande" parent="">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Campos com cantos arredondados (16dp) como na web -->
    <style name="Widget.TarefaApp.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="startIconTint">@color/ouro_500</item>
    </style>

    <style name="Widget.TarefaApp.Campo.Lista" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="Widget.TarefaApp.Campo.Denso" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="startIconTint">@color/ouro_500</item>
    </style>

    <style name="Widget.TarefaApp.Campo.Denso.Lista" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="Widget.TarefaApp.Cartao" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/borda_suave</item>
        <item name="cardBackgroundColor">@color/branco</item>
    </style>

    <style name="TextAppearance.TarefaApp.Titulo" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/texto_forte</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TarefaApp.Info" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
