<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone para Android 7.x (API 24/25), que não suporta adaptive-icon -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="@color/ouro_600"
                android:centerColor="@color/ouro_500"
                android:startColor="@color/ouro_claro" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
